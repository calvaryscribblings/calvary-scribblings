rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /covers/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == 'XaG6bTGqdDXh7VkBTw4y1H2d2s82' || request.auth.uid == 'GfXFIc0dThZ1cs2SBBQIFao4aSz1');
    }
    match /authors/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && (request.auth.uid == 'XaG6bTGqdDXh7VkBTw4y1H2d2s82' || request.auth.uid == 'GfXFIc0dThZ1cs2SBBQIFao4aSz1')
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    // Voices of the Island — card + portrait images. Public read, admin write,
    // max 5 MB, image/* only. Slug-keyed to match cms_voices.
    match /voices/{slug}/{file} {
      allow read: if true;
      allow write: if request.auth != null
                   && (request.auth.uid == 'XaG6bTGqdDXh7VkBTw4y1H2d2s82' || request.auth.uid == 'GfXFIc0dThZ1cs2SBBQIFao4aSz1')
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    // Newsletter images. Public read, admin write, max 5 MB, image/* only.
    // Issue-keyed, same shape as voices/ above.
    //
    // ⚠ WRITE-ONCE BY CONVENTION. Objects under newsletter/ are never deleted,
    // renamed, or re-uploaded in place. A sent email cannot be patched: it
    // holds an absolute URL to this object, and every copy in every inbox will
    // fetch it for as long as the issue is read. Replacing an object breaks the
    // picture in mail that has already landed; deleting one leaves a permanent
    // hole. The rules cannot enforce this — delete is a client operation the
    // admin UID is allowed to perform — so the enforcement lives in the upload
    // helper (app/lib/newsletterImages.js), which only ever creates new paths.
    match /newsletter/{issueId}/{file} {
      allow read: if true;
      allow write: if request.auth != null
                   && (request.auth.uid == 'XaG6bTGqdDXh7VkBTw4y1H2d2s82' || request.auth.uid == 'GfXFIc0dThZ1cs2SBBQIFao4aSz1')
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    match /pdfs/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == 'XaG6bTGqdDXh7VkBTw4y1H2d2s82' || request.auth.uid == 'GfXFIc0dThZ1cs2SBBQIFao4aSz1');
    }
    match /epubs/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == 'XaG6bTGqdDXh7VkBTw4y1H2d2s82' || request.auth.uid == 'GfXFIc0dThZ1cs2SBBQIFao4aSz1');
    }
    match /story_authors/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == 'XaG6bTGqdDXh7VkBTw4y1H2d2s82' || request.auth.uid == 'GfXFIc0dThZ1cs2SBBQIFao4aSz1');
    }
    match /avatars/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /headers/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // R21 — WRITE IS SPLIT FROM DELETE HERE, AND IN THE TWO EPUB RULES BELOW, BECAUSE A
    // COMBINED `allow write` CANNOT EXPRESS A DELETE AT ALL.
    //
    // On a delete, `request.resource` is NULL. Every one of these rules guarded on
    // `request.resource.size` and `request.resource.contentType`, so a delete evaluated those
    // against null and was DENIED — for the founders too. That is why R21's delete path needed
    // a rules change and not just code: before this split, `deleteTitle` could remove the
    // record and then fail on every single file, leaving the whole bucket's worth of a deleted
    // title behind with nothing pointing at it.
    //
    // The size and content-type guards stay exactly where they belong — on create and update,
    // which are the operations that put bytes in the bucket. Delete needs only the identity.
    match /bookstore_covers/{titleId} {
      allow read: if true;
      allow create, update: if request.auth != null
                   && (request.auth.uid == 'XaG6bTGqdDXh7VkBTw4y1H2d2s82' || request.auth.uid == 'GfXFIc0dThZ1cs2SBBQIFao4aSz1')
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
                   && (request.auth.uid == 'XaG6bTGqdDXh7VkBTw4y1H2d2s82' || request.auth.uid == 'GfXFIc0dThZ1cs2SBBQIFao4aSz1');
    }
    // ⛔ THE MASTER EPUB. `allow delete` is granted to the founders and the RULE CANNOT BE THE
    // GUARD THAT MATTERS. R21's ruling is "the master is not deleted if anyone owns the book",
    // and a Storage rule cannot count purchases — bookstore_purchases is in a different
    // product. Writing a rule that LOOKED like it enforced the ruling would be worse than
    // this: it would move the reader's confidence to a line that cannot hold it.
    //
    // The guard is deletionPlan() in app/lib/bookstore/withdrawal.js, which never puts an owned
    // master in a delete list, and tests/bookstore/withdrawal.test.mjs fails if it ever does.
    // Read that before changing anything here.
    match /bookstore_epubs/{titleId}/master.epub {
      allow read: if false;
      allow create, update: if request.auth != null
                   && (request.auth.uid == 'XaG6bTGqdDXh7VkBTw4y1H2d2s82' || request.auth.uid == 'GfXFIc0dThZ1cs2SBBQIFao4aSz1')
                   && request.resource.size < 50 * 1024 * 1024
                   && request.resource.contentType == 'application/epub+zip';
      allow delete: if request.auth != null
                   && (request.auth.uid == 'XaG6bTGqdDXh7VkBTw4y1H2d2s82' || request.auth.uid == 'GfXFIc0dThZ1cs2SBBQIFao4aSz1');
    }
    match /bookstore_epubs/{titleId}/sample.epub {
      allow read: if true;
      allow create, update: if request.auth != null
                   && (request.auth.uid == 'XaG6bTGqdDXh7VkBTw4y1H2d2s82' || request.auth.uid == 'GfXFIc0dThZ1cs2SBBQIFao4aSz1')
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType == 'application/epub+zip';
      allow delete: if request.auth != null
                   && (request.auth.uid == 'XaG6bTGqdDXh7VkBTw4y1H2d2s82' || request.auth.uid == 'GfXFIc0dThZ1cs2SBBQIFao4aSz1');
    }
    // THE SERIES — instalment master EPUBs.
    //
    // `read: if false`, exactly like bookstore_epubs/{titleId}/master.epub, and for a reason
    // this project has already paid for once. The Book Reader Collection stored its EPUBs
    // under `epubs/**`, which is `allow read: if true`, as permanent Firebase download URLs
    // carrying their own access token. Every one of those files was fetchable, signed out,
    // by anyone who read cms_stories — which is `.read: true`. That is why the collection
    // could never be gated by anything, and it is the single fact this prefix exists to not
    // repeat.
    //
    // The ONLY path to these bytes is a ~300-second signed URL minted by
    // functions/api/series/stream.js after it has checked release, identity and membership.
    // A signed URL is a Cloud-Storage-level grant evaluated BEFORE this rule layer, so the
    // two coexist by design rather than by accident: if a download breaks, suspect the
    // signature or the bucket CORS config, never this line.
    //
    // The admin can WRITE and cannot READ. That is correct and occasionally surprising —
    // app/lib/series/admin-writes.js:uploadInstalmentEpub deliberately never calls
    // getDownloadURL(), because a download URL for this object would be exactly the public,
    // permanent, token-bearing link the prefix exists to prevent.
    //
    // CORS needs no work: scripts/bookstore-set-cors.mjs sets a BUCKET-level policy, so a
    // new prefix in the same bucket inherits it.
    match /series_epubs/{instalmentId}/master.epub {
      allow read: if false;
      allow write: if request.auth != null
                   && (request.auth.uid == 'XaG6bTGqdDXh7VkBTw4y1H2d2s82' || request.auth.uid == 'GfXFIc0dThZ1cs2SBBQIFao4aSz1')
                   && request.resource.size < 50 * 1024 * 1024
                   && request.resource.contentType == 'application/epub+zip';
    }
    // Series and instalment artwork — the poster and any per-instalment cover. Public read,
    // because a locked instalment still shows its art; only the FILE is gated.
    match /series_covers/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && (request.auth.uid == 'XaG6bTGqdDXh7VkBTw4y1H2d2s82' || request.auth.uid == 'GfXFIc0dThZ1cs2SBBQIFao4aSz1')
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    match /bookstore_epubs/{titleId}/buyers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /calvary_films/{slug}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && (request.auth.uid == 'XaG6bTGqdDXh7VkBTw4y1H2d2s82' || request.auth.uid == 'GfXFIc0dThZ1cs2SBBQIFao4aSz1')
                   && request.resource.size < 50 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }
    // R9.0 LB-6: `request.auth != null` was ABSENT here, and this was the only
    // write rule in the file without an auth term. Anyone on the internet could
    // upload unlimited 25 MB PDFs to caller-chosen paths in the billed bucket,
    // and overwrite a genuine submission before an operator read it.
    //
    // Verified before tightening: NOTHING in app/ or functions/ uploads to this
    // prefix — the submission form that presumably used it is not in this repo.
    // If a public, signed-out submission form is reintroduced, it must sign the
    // reader in anonymously first rather than have this line removed again.
    match /film_submissions/{submissionId}/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == 'XaG6bTGqdDXh7VkBTw4y1H2d2s82' || request.auth.uid == 'GfXFIc0dThZ1cs2SBBQIFao4aSz1');
      allow write: if request.auth != null
                   && request.resource.size < 25 * 1024 * 1024
                   && request.resource.contentType == 'application/pdf';
    }
    match /open_pages/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }
  }
}