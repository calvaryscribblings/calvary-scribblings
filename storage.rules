rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /covers/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == 'XaG6bTGqdDXh7VkBTw4y1H2d2s82' || request.auth.uid == 'GfXFIc0dThZ1cs2SBBQIFao4aSz1');
    }
    match /authors/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && (request.auth.uid == 'XaG6bTGqdDXh7VkBTw4y1H2d2s82' || request.auth.uid == 'GfXFIc0dThZ1cs2SBBQIFao4aSz1')
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    // Voices of the Island — card + portrait images. Public read, admin write,
    // max 5 MB, image/* only. Slug-keyed to match cms_voices.
    match /voices/{slug}/{file} {
      allow read: if true;
      allow write: if request.auth != null
                   && (request.auth.uid == 'XaG6bTGqdDXh7VkBTw4y1H2d2s82' || request.auth.uid == 'GfXFIc0dThZ1cs2SBBQIFao4aSz1')
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    match /pdfs/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == 'XaG6bTGqdDXh7VkBTw4y1H2d2s82' || request.auth.uid == 'GfXFIc0dThZ1cs2SBBQIFao4aSz1');
    }
    match /epubs/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == 'XaG6bTGqdDXh7VkBTw4y1H2d2s82' || request.auth.uid == 'GfXFIc0dThZ1cs2SBBQIFao4aSz1');
    }
    match /story_authors/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == 'XaG6bTGqdDXh7VkBTw4y1H2d2s82' || request.auth.uid == 'GfXFIc0dThZ1cs2SBBQIFao4aSz1');
    }
    match /avatars/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /headers/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /bookstore_covers/{titleId} {
      allow read: if true;
      allow write: if request.auth != null
                   && (request.auth.uid == 'XaG6bTGqdDXh7VkBTw4y1H2d2s82' || request.auth.uid == 'GfXFIc0dThZ1cs2SBBQIFao4aSz1')
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    match /bookstore_epubs/{titleId}/master.epub {
      allow read: if false;
      allow write: if request.auth != null
                   && (request.auth.uid == 'XaG6bTGqdDXh7VkBTw4y1H2d2s82' || request.auth.uid == 'GfXFIc0dThZ1cs2SBBQIFao4aSz1')
                   && request.resource.size < 50 * 1024 * 1024
                   && request.resource.contentType == 'application/epub+zip';
    }
    match /bookstore_epubs/{titleId}/sample.epub {
      allow read: if true;
      allow write: if request.auth != null
                   && (request.auth.uid == 'XaG6bTGqdDXh7VkBTw4y1H2d2s82' || request.auth.uid == 'GfXFIc0dThZ1cs2SBBQIFao4aSz1')
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType == 'application/epub+zip';
    }
    match /bookstore_epubs/{titleId}/buyers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /calvary_films/{slug}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && (request.auth.uid == 'XaG6bTGqdDXh7VkBTw4y1H2d2s82' || request.auth.uid == 'GfXFIc0dThZ1cs2SBBQIFao4aSz1')
                   && request.resource.size < 50 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }
    match /film_submissions/{submissionId}/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == 'XaG6bTGqdDXh7VkBTw4y1H2d2s82' || request.auth.uid == 'GfXFIc0dThZ1cs2SBBQIFao4aSz1');
      allow write: if request.resource.size < 25 * 1024 * 1024
                   && request.resource.contentType == 'application/pdf';
    }
    match /open_pages/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }
  }
}