{
  "name": "calvary-scribblings-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/generate-redirects.mjs && node scripts/generate-gateway-wall.mjs && next build && node scripts/stamp-sw.mjs",
    "start": "next start",
    "lint": "eslint",
    "rules:deploy": "GOOGLE_APPLICATION_CREDENTIALS=serviceAccountKey.json firebase deploy --only database,storage --project calvary-scribblings --non-interactive",
    "rules:deploy:db": "GOOGLE_APPLICATION_CREDENTIALS=serviceAccountKey.json firebase deploy --only database --project calvary-scribblings --non-interactive",
    "rules:deploy:storage": "GOOGLE_APPLICATION_CREDENTIALS=serviceAccountKey.json firebase deploy --only storage --project calvary-scribblings --non-interactive",
    "rules:pull": "node scripts/rules-pull.mjs",
    "rules:check": "node scripts/rules-check.mjs",
    "foliate:check": "node scripts/foliate-lock.mjs --check",
    "foliate:write": "node scripts/foliate-lock.mjs --write",
    "foliate:list": "node scripts/foliate-lock.mjs --list",
    "test:reader": "node tests/fixtures/make-epub.mjs && playwright test -c tests/reader/playwright.config.mjs",
    "test:reader:app": "node tests/fixtures/make-epub.mjs && next build && playwright test -c tests/reader/playwright.app.config.mjs",
    "test:reader:all": "npm run test:reader && npm run test:reader:app",
    "test:gate": "next build && playwright test -c tests/bookstore/playwright.gate.config.mjs",
    "test:currency": "next build && playwright test -c tests/bookstore/playwright.currency.config.mjs",
    "test:territory": "next build && playwright test -c tests/bookstore/playwright.territory.config.mjs",
    "test:placement": "next build && playwright test -c tests/bookstore/playwright.placement.config.mjs",
    "test:boundbook": "next build && playwright test -c tests/bookstore/playwright.boundbook.config.mjs",
    "test:masthead": "next build && playwright test -c tests/bookstore/playwright.masthead.config.mjs",
    "test:flip": "next build && playwright test -c tests/bookstore/playwright.flip.config.mjs",
    "test:pair": "next build && playwright test -c tests/bookstore/playwright.pair.config.mjs",
    "test:payload": "next build && playwright test -c tests/bookstore/playwright.payload.config.mjs",
    "covers:backfill": "node scripts/backfill-bookstore-cover-derivatives.mjs",
    "bench:grain": "node scripts/bench-grain-frames.mjs",
    "test:newsletter": "node --test \"tests/newsletter/*.test.mjs\"",
    "test:purchases": "node --test \"tests/bookstore/*.test.mjs\"",
    "test:withdrawals": "node --test tests/bookstore/withdrawal.test.mjs",
    "test:membership": "node --test \"tests/membership/*.test.mjs\"",
    "test:rules": "firebase emulators:exec --only database,storage --project demo-calvary-rules \"node --test --test-concurrency=1 tests/rules/*.test.mjs\"",
    "test:sponsor": "firebase emulators:exec --only auth,database,storage --project calvary-scribblings \"playwright test -c tests/series/playwright.sponsor.config.mjs\"",
    "test:ci": "node --test \"tests/ci/*.test.mjs\"",
    "test:build": "node --test tests/build/liveness.test.mjs",
    "test:redirects": "node --test tests/build/redirects-limits.test.mjs",
    "test:membership-copy": "next build && node --test tests/membership/deck-parity.test.mjs && playwright test -c tests/membership/playwright.copy.config.mjs && playwright test -c tests/membership/playwright.links.config.mjs",
    "test:dropcap": "playwright test -c tests/dropcap/playwright.config.mjs",
    "test:verify-email": "playwright test -c tests/verify-email/playwright.config.mjs",
    "lint:ratchet": "node scripts/lint-ratchet.mjs",
    "covers:generate": "node scripts/covers/generate.mjs",
    "covers:sheet": "node scripts/covers/contact-sheet.mjs --out covers-contact-sheet",
    "covers:verify": "node --test \"tests/covers/*.test.mjs\"",
    "covers:migrate": "node scripts/covers/migrate.mjs",
    "covers:reconcile": "node scripts/covers/on-publish.mjs",
    "covers:lock": "node scripts/covers/design-lock.mjs --write",
    "covers:lock:check": "node scripts/covers/design-lock.mjs",
    "covers:descriptors": "node scripts/covers/descriptor-sheet.mjs"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@napi-rs/canvas": "1.0.6",
    "@next/mdx": "^16.2.1",
    "blurhash": "^2.0.5",
    "firebase": "^12.11.0",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "firebase-admin": "^14.2.0",
    "firebase-tools": "^15.24.0",
    "opentype.js": "2.0.0",
    "tailwindcss": "^4"
  }
}
