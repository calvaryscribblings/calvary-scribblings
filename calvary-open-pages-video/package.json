{
  "name": "calvary-open-pages-video",
  "version": "2.0.0",
  "private": true,
  "description": "Open Pages promotional video — Calvary Scribblings (60s, Remotion)",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render OpenPagesVideo out/open-pages-video.mp4 --codec h264",
    "render-4k": "remotion render OpenPagesVideo out/open-pages-video-4k.mp4 --codec h264 --scale 2",
    "still": "remotion still OpenPagesVideo out/poster.png --frame 1290"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "typescript": "^5.5.0"
  }
}
