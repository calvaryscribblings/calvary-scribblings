          ".validate": "newData.isString() && newData.val().length >= 5 && newData.val().length <= 320 && newData.val().matches(/^[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)+$/)"
