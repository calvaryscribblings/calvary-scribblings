        "readCount": {
          ".write": "auth != null && newData.isNumber()"
        }
      }
    },
    "open_pages_pending": {
      ".read": "auth != null && (auth.uid === 'XaG6bTGqdDXh7VkBTw4y1H2d2s82' || auth.uid === 'GfXFIc0dThZ1cs2SBBQIFao4aSz1')",
      "$postId": {
        ".read": "auth != null && (data.child('authorUid').val() === auth.uid || auth.uid === 'GfXFIc0dThZ1cs2SBBQIFao4aSz1' || auth.uid === 'XaG6bTGqdDXh7VkBTw4y1H2d2s82')",
        ".write": "auth != null && (auth.uid === 'GfXFIc0dThZ1cs2SBBQIFao4aSz1' || auth.uid === 'XaG6bTGqdDXh7VkBTw4y1H2d2s82' || (!data.exists() && newData.child('authorUid').val() === auth.uid) || (data.exists() && data.child('authorUid').val() === auth.uid))",
        ".validate": "newData.hasChildren(['authorUid', 'title', 'body', 'status', 'createdAt'])",
        "authorUid": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "title": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "body": {
          ".validate": "newData.isString() && newData.val().length <= 50000"
        },
        "status": {
          ".validate": "newData.isString() && (newData.val() === 'pending' || newData.val() === 'live' || newData.val() === 'flagged' || newData.val() === 'removed')"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": true
        }
      }
    },
    "open_pages_reports": {
      ".read": "auth != null && (auth.uid === 'XaG6bTGqdDXh7VkBTw4y1H2d2s82' || auth.uid === 'GfXFIc0dThZ1cs2SBBQIFao4aSz1')",
      ".write": "auth != null && (auth.uid === 'XaG6bTGqdDXh7VkBTw4y1H2d2s82' || auth.uid === 'GfXFIc0dThZ1cs2SBBQIFao4aSz1')",
      "$postId": {
        "$reporterUid": {
          ".write": "auth != null && auth.uid === $reporterUid",
          ".validate": "newData.hasChildren(['reason','reporterUid','createdAt']) && newData.child('reporterUid').val() === $reporterUid && newData.child('reason').isString() && newData.child('createdAt').isNumber()"
        }
