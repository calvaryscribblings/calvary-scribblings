      ".read": true,
      ".write": "auth != null && (auth.uid === 'XaG6bTGqdDXh7VkBTw4y1H2d2s82' || auth.uid === 'GfXFIc0dThZ1cs2SBBQIFao4aSz1')",
      ".indexOn": ["seriesId", "ordinal", "releaseAtMs", "status"],
      "$instalmentId": {
        ".validate": "newData.hasChildren(['schemaVersion', 'seriesId', 'ordinal', 'releaseAtMs', 'freeForGold', 'status', 'addedAt', 'updatedAt'])",
        "releaseAtMs": { ".validate": "newData.isNumber() && newData.val() > 0" },
        "ordinal": { ".validate": "newData.isNumber() && newData.val() >= 1" },
