# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
_worker.js

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# firebase emulator debris
firebase-debug.log*
database-debug.log*
firestore-debug.log*
pubsub-debug.log*
ui-debug.log*
dataconnect-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
serviceAccountKey.json

# vestigial sibling projects living in the workspace (separate projects — ignore,
# do not commit). They are not part of this Next.js app.
/calvary-app/
/calvary-brand-video/
/calvary-scribblings-next/
/calvary-open-pages-video/

# build artifacts / archives (any depth — catches nested vendor builds too)
.next/
out/
*.zip

# Gateway cover wall — regenerated from cms_stories on every build by
# scripts/generate-gateway-wall.mjs (WebP tiles + manifest.json). Build output,
# not source; never commit. Cloudflare Pages regenerates it fresh each deploy.
/public/gateway-wall/
# Harness fixture EPUBs — generated byte-identically by tests/fixtures/make-epub.mjs,
# which every test run (and CI) invokes first. Generated, not source.
tests/fixtures/harness-book.epub
tests/fixtures/harness-book-short.epub
test-results/
playwright-report/
tests/fixtures/*.master.epub
samples/
tests/fixtures/*.sample.epub
tests/fixtures/harness-sample.epub

# scripts/build-epub.mjs writes here by default. Built books are artefacts, not source —
# the template that produces them is the thing under review, and it lives in scripts/.
dist/

# tests/fixtures/cross-surface/make-epub.mjs (the app's generator) writes here. The fixture is
# GENERATED, not committed: byte-identity is derived from source on every run, and a binary in
# git is a fixture nobody can review. See docs/cfi-exchange-protocol.md.
tests/fixtures/cross-surface/build/

# Cover generator OUTPUT. Both directories are reproducible from the repo alone —
# `npm run covers:sheet` rebuilds the sheet, and the migration manifest is rebuilt by
# re-running the migration, which resumes rather than restarts. Neither belongs in git:
# the sheet is ~1.7 MB of PNG per build, and covers-migration/png holds ~150 more.
# covers-migration/SIGNOFF.md is the ONE file here that is a decision rather than an
# artefact, so it is explicitly un-ignored — a sign-off should be reviewable in the diff.
covers-contact-sheet/
# NOTE the trailing /* rather than a bare directory. Git does not descend into an excluded
# DIRECTORY, so a `!` negation inside one never gets a chance to match — `covers-migration/`
# followed by `!covers-migration/SIGNOFF.md` silently ignored the sign-off too. Excluding the
# directory's CONTENTS instead keeps the negation reachable. Same for RATIFIED.md below.
covers-migration/*
!covers-migration/SIGNOFF.md
covers-descriptors/*
!covers-descriptors/RATIFIED.md

# scripts/backup/export.mjs writes here. NEVER commit: these archives contain every
# reader's email address and password hash, plus the master EPUBs. Keep them off this
# machine entirely — see scripts/backup/RESTORE.md.
backups/

# R18 — the JSX render harness in tests/bookstore/author-render.test.mjs transforms a component
# beside its source and imports it. after() removes it; this is the safety net for a crashed run.
app/**/.*.test-build.mjs

# One-off essay export (scripts/export-essays.mjs). Full story text — never committed.
essays-export.md
